DJANGO_SECRET_KEY=change-this-in-development
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Keep DB_ENGINE=sqlite while Django is being developed independently.
DB_ENGINE=sqlite

# Switch to these later when Django should use PostgreSQL.
DB_NAME=mealplan
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
